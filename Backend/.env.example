MONGODB_URI=mongodb+srv://<your-username>:<your-password>@cluster0.xxxxx.mongodb.net
JWT_SECRET=any_long_random_string_here
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret
PORT=4000
ADMIN_EMAIL=admin@swiftcare.com
ADMIN_PASSWORD=your_admin_password_here
DB_NAME=prescripto

# Optional: URL of the default avatar shown when a user has no profile photo.
# Leave blank to show initials/placeholder in the frontend instead.
DEFAULT_AVATAR_URL=

# Logging — "trace" | "debug" | "info" | "warn" | "error" | "fatal"
# Defaults to "info". Set "debug" locally for verbose output.
LOG_LEVEL=info
# Nodemailer (Gmail) — use an App Password, not your real Gmail password
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Paystack secret key (sk_test_... for test mode, sk_live_... for production)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL — used in password reset email links and Paystack callback
FRONTEND_URL=https://swiftcare-platform.vercel.app
